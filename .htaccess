# Used only when the domain's document root is the project folder (cPanel default for a new subdomain).
# Best: document root = public/. Either way, everything is served from public/ and nothing else is reachable.
Options -Indexes

# Private files: .env*, dot files, SQL dumps, logs, docs, composer/package files, scripts, PHP settings
<FilesMatch "(^\.|\.(env|sql|log|md|lock|ini|sh|ps1|bat|zip|xml|yml|yaml|cache|key)$|^(artisan|composer\.json|package\.json|vite\.config\.js)$)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Code, secrets, data and logs are never served
    RewriteRule ^(app|bootstrap|config|database|deploy|docs|legacy|resources|routes|storage|tests|tools|vendor|node_modules|\.git|\.github)(/|$) - [F,L]

    # SSL certificate checks (AutoSSL / Let's Encrypt) stay in the project folder
    RewriteRule ^\.well-known/ - [L]

    # Everything else is served from public/ (public/.htaccess then hands it to Laravel)
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
