APP_NAME="SundayBazar ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost/sundaybazaarErp/public
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sundaybazar_erp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=strict

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Shopify (Dev Dashboard app, client-credentials grant) ---
# Admin API host is the *.myshopify.com domain, NOT www.sundaybazar.com.pk
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2025-10
# Optional: a fixed Admin API access token (shpat_...) from an older custom app. Leave empty to use client credentials.
SHOPIFY_ACCESS_TOKEN=
# Separate webhook signing secret only if webhooks were created in the Shopify admin (Settings > Notifications).
# Webhooks registered by this app are signed with SHOPIFY_CLIENT_SECRET.
SHOPIFY_WEBHOOK_SECRET=
# Two-way sync (ERP -> Shopify). On = changes made in the ERP are sent to Shopify. Set one to false only as an emergency stop.
SHOPIFY_WRITE_PRICES=true
SHOPIFY_WRITE_INVENTORY=true
SHOPIFY_WRITE_FULFILLMENTS=true
SHOPIFY_WRITE_TAGS=true
SHOPIFY_WRITE_ORDER_CANCEL=true
SHOPIFY_WRITE_REFUNDS=true

# --- PostEx courier ---
POSTEX_TOKEN=

# First-run owner setup key (optional; see config/erp.php)
ERP_SETUP_KEY=

# Login & registration (see config/erp.php)
ERP_REGISTRATION=approval
ERP_REGISTRATION_ROLE=staff
# One-time first administrator (php artisan erp:install). Remove the password after the first run.
ERP_ADMIN_EMAIL=
ERP_ADMIN_PASSWORD=
ERP_ADMIN_NAME=Owner

# Background sync without cron: the web app starts "php artisan erp:tick" when no scheduler ran it (see config/erp.php)
ERP_AUTOTICK=true
ERP_PHP_BINARY=

# Live -> local data copy (php artisan erp:pull-production). Live server: ERP_SNAPSHOT_TOKEN only. Local PC: both.
ERP_SNAPSHOT_TOKEN=
ERP_PRODUCTION_URL=
